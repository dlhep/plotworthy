# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# The site runs fine with these unset — features activate as you add them.

# --- Supabase (database) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
# Where new-application alerts go. Until you verify the plotworthy.co.uk domain
# in Resend, set this to the email you registered with Resend (that's the only
# address Resend will deliver to on the free tier). After verifying the domain,
# set it to hello@plotworthy.co.uk.
ADMIN_EMAIL=hello@plotworthy.co.uk
# Sender. Use the default until your domain is verified, then switch to hello@.
EMAIL_FROM=PlotWorthy <onboarding@resend.dev>
# EMAIL_FROM=PlotWorthy <hello@plotworthy.co.uk>

# --- Admin gate (review applications at /admin/applications) ---
ADMIN_PASSWORD=

# --- Site URL (used for links inside emails) ---
NEXT_PUBLIC_SITE_URL=https://plotworthy.co.uk
